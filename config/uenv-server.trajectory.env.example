# Copy to Server (8.130.75.157) as /root/.uenv-server.env (chmod 600)
# Used together with uenv-adapter-core (gRPC :8088 + trajectory HTTP :8077)
#
# 变量名与实现一致：Server 端读取 UENV_TRAJECTORY_ENABLED / UENV_TRAJECTORY_HTTP_LISTEN /
# UENV_TRAJECTORY_DATA_DIR / UENV_TRAJECTORY_TOKEN（另支持 UENV_TRAJECTORY_RETENTION_DAYS，
# 默认 0 表示不自动删除；见 uenv-server/src/trajectory/config.rs）。
#
# Token 来源：
# - install.sh --enable-swe 单机安装会自动生成 UENV_TRAJECTORY_TOKEN 并追加到
#   /etc/uenv/secrets/swe.env，server 单元通过 EnvironmentFile=-/etc/uenv/secrets/swe.env 加载；
# - 多机场景需手工把同一个 token 分发到 Server 与所有 Worker，两侧必须一致。

export UENV_ADDR=0.0.0.0:8088
export UENV_CONFIG_PATH=/home/uenv/config/server.yaml

# Logging
export RUST_LOG=info,uenv_server=info,uenv_adapter_core=info,tower_http=warn
export UENV_LOG_FORMAT=json
export UENV_LOG_ANSI=0

# Trajectory v2.2 aggregation（Worker 侧 v2.3 起支持 UENV_TRAJECTORY_ARTIFACT_DIR，
# 回退 UENV_SWE_ARTIFACT_DIR；本文件为 Server 侧配置，不涉及该变量）
# DATA_DIR 与 install.sh 创建的 /var/lib/uenv/server/trajectory 对齐；
# 手工部署到其他路径时需保证目录存在且服务账号可写。
export UENV_TRAJECTORY_ENABLED=1
export UENV_TRAJECTORY_HTTP_LISTEN=0.0.0.0:8077
export UENV_TRAJECTORY_DATA_DIR=/home/uenv/trajectory-data
export UENV_TRAJECTORY_TOKEN=REPLACE_WITH_RANDOM_TRAJECTORY_TOKEN

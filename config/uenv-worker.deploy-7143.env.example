# Copy to 7143 as /root/.uenv-worker.env (chmod 600). DO NOT commit with real token.
export UENV_HUB_TOKEN=uenvh_xxxxxxxx
export UENV_MATH_PLUGIN_BIN=/root/UEnv/target/release/uenv-math-plugin
export UENV_PLUGIN_DIR=/root/UEnv/plugins
export UENV_PREWARM_ON_STARTUP=true

# SWE timeout hierarchy (7143): exec 180s, pytest batch 900s, episode/submit 1800s,
# native docker exec 1200s. Keep these values aligned with the restart script.
export UENV_WORKER_GATEWAY_EXEC_TIMEOUT_SECS=180
export UENV_WORKER_GATEWAY_SUBMIT_TIMEOUT_SECS=1800
export UENV_WORKER_EXEC_TIMEOUT_SECS=1200
export UENV_WORKER_EPISODE_TIMEOUT_SECS=1800
export UENV_WORKER_DISPATCH_HEARTBEAT_SECS=15


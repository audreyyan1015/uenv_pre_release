# /etc/uenv-toolenv.env — Agent 机（208.77）ToolEnv Agent 部署配置。
# 由 scripts/toolenv/bootstrap_toolenv_agent.sh 安装为 /etc/uenv-toolenv.env（首次不覆盖）。

# --- 控制面 ---
UENV_ADAPTER_CORE_ENDPOINT=8.130.75.157:8088
UENV_SERVER_ENDPOINT=8.130.75.157:8088

# --- 策略 / 模型 ---
# POLICY=mock：免-LLM 链路自检 / B3 编排冒烟（不依赖外部推理）。
# POLICY=llm：正式评测；必须填写可达的稳定 OpenAI 兼容端点。
# 注意：勿再指向已释放的 7142 临时 vLLM（:18088 / :18099）。
POLICY=llm
LLM_ENDPOINT=http://REPLACE_WITH_STABLE_VLLM_OR_API/v1
LLM_MODEL=REPLACE_WITH_MODEL_NAME
LLM_API_KEY=

# --- 数据与评测口径 ---
DATA_FILE=/opt/uenv-toolenv/app/data/benchmarks/dscodebench/DSCodeBench.json
LIMIT=
LIBRARY=
MAX_PER_LIBRARY=
NUM_TESTS=200
MAX_TURNS=4
MAX_TOKENS=2048
PROMPT_STYLE=official
EVALUATION_MODE=inline_harness
RESUME=1

# --- 判分回传 shim ---
# 跨机：Worker(7143) 需能出站访问该地址；208.77 已开放 8099
# 与 OpenHands（:8888/:8777）端口隔离，勿占用同一端口。
SHIM_HOST=0.0.0.0
SHIM_PORT=8099
SHIM_PUBLIC_URL=http://8.130.208.77:8099/v1

# --- AgentJob 常驻（B3，uenv-toolenv-poller.service）---
# bridge / pool 与 OpenHands（uenv-agent-openhands / openhands-default）独立演进，勿共用版本号习惯。
TOOLENV_AGENT_POOL_ID=toolenv-default
TOOLENV_AGENT_BRIDGE_ID=uenv-agent-toolenv
TOOLENV_AGENT_BRIDGE_VERSION=1.0.0
TOOLENV_POLL_INTERVAL_SEC=3
TOOLENV_MAX_CONCURRENT=1
TOOLENV_OH_RUNTIME=/root/UEnv/integrations/openhands

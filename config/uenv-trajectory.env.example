# Shared trajectory upload/read token (Worker + Server + OpenHands verify).
# Copy to 7143 / 208.77 as /root/.uenv-trajectory.env (chmod 600)
#
# 变量名与实现一致：Worker 上传端读取 UENV_TRAJECTORY_ENDPOINT / UENV_TRAJECTORY_TOKEN
# （uenv-worker/src/swe/trajectory_upload.rs），请求头为 X-Trajectory-Token。
#
# v2.3 起轨迹 artifact 根目录可用 UENV_TRAJECTORY_ARTIFACT_DIR 配置（SWE 与通用 episode 共用）；
# 未设置时回退 UENV_SWE_ARTIFACT_DIR，既有 SWE 部署无需改动。
#
# Token 来源：
# - install.sh --enable-swe 单机安装会自动生成 UENV_TRAJECTORY_TOKEN 并追加到
#   /etc/uenv/secrets/swe.env（Server 与 Worker 的 systemd 单元都加载该文件，单机自动闭环）；
# - 多机场景需手工生成一个 token，并分发到 Server 与所有 Worker
#   （各节点 /etc/uenv/secrets/swe.env 或本文件），两侧必须完全一致。
#
# 注意：install.sh 生成的 swe.env 中 UENV_SWE_ARTIFACT_DIR 默认为
# /var/lib/uenv/worker/swe-artifacts；本文件的取值是实验室手工部署的历史路径。

export UENV_TRAJECTORY_TOKEN=REPLACE_WITH_RANDOM_TRAJECTORY_TOKEN
export UENV_TRAJECTORY_ENDPOINT=http://8.130.75.157:8077
# v2.3：轨迹 artifact 根目录（bodies/ + index/ + spool/）；未设置时回退 UENV_SWE_ARTIFACT_DIR。
# 通用（非 SWE）episode 的轨迹也 seal 到该目录并经 UENV_TRAJECTORY_ENDPOINT 上传。
#export UENV_TRAJECTORY_ARTIFACT_DIR=/var/lib/uenv/trajectory-artifacts
export UENV_SWE_ARTIFACT_DIR=/var/lib/uenv/swe-artifacts
export UENV_SWE_GATEWAY_PUBLIC_URL=http://219.147.100.43:28097

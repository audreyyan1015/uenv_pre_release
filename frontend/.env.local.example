# 复制为 .env.local 后按需修改（.env.local 不提交仓库）。
#
# 未配置 VITE_AGGREGATION_BASE_URL → 纯离线 Fixture 演示（不访问网络）。
# 已配置但 Obs 不可达 → 自动 Mock 回落（本地占位数据 + 顶栏「Mock 回落」标记）。
# 已配置且可达、但 Bridge/Worker 尚未上报 → 显示空工作流占位（不报错）。

VITE_AGGREGATION_BASE_URL=http://127.0.0.1:50053
VITE_AGGREGATION_TOKEN=
VITE_DEFAULT_RUN_ID=_orphan

# Hub 控制台必须打开 Hub 源站（绝对 URL），不要用 /hub/console。
# 代码默认：http://8.130.95.176:8088/；本地可覆盖为：
# VITE_HUB_CONSOLE_URL=http://127.0.0.1:8088/
# 拓扑页遥测仍走 Vite /hub 代理（见 vite.config.ts 的 VITE_HUB_PROXY_TARGET）。
# VITE_HUB_TOKEN=

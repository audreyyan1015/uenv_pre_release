#!/usr/bin/env python3
"""UEnv unified operations CLI.

The environment authoring commands are delegated to the Hub client binary;
service inspection stays dependency-free so it also works on worker-only nodes.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request


DEFAULT_ROOT = Path(os.environ.get("UENV_INSTALL_ROOT", "/opt/uenv/current"))
DEFAULT_CONFIG = Path(os.environ.get("UENV_CONFIG_DIR", "/etc/uenv"))
DEFAULT_ADMIN_URL = os.environ.get("UENV_ADMIN_URL", "http://127.0.0.1:50052")
DEFAULT_WORKER_URL = os.environ.get("UENV_WORKER_HEALTH_URL", "http://127.0.0.1:19090")
SERVICES = {
    "server": "uenv-adapter-core.service",
    "worker": "uenv-worker.service",
    "hub": "uenv-hub.service",
}


class CliError(RuntimeError):
    pass


def http_json(url: str, timeout: float = 4.0) -> dict:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            body = response.read()
    except (urllib.error.URLError, TimeoutError) as exc:
        raise CliError(f"无法访问 {url}: {exc}") from exc
    try:
        return json.loads(body)
    except json.JSONDecodeError as exc:
        raise CliError(f"{url} 返回的不是有效 JSON") from exc


def http_ok(url: str, timeout: float = 3.0) -> tuple[bool, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            body = response.read(200).decode("utf-8", "replace").strip()
            return 200 <= response.status < 300, body
    except (urllib.error.URLError, TimeoutError) as exc:
        return False, str(exc)


def fmt_secs(value: object) -> str:
    if value is None:
        return "-"
    seconds = int(value)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def fetch_status(args: argparse.Namespace) -> dict:
    return http_json(f"{args.admin_url.rstrip('/')}/status")


def print_status(data: dict) -> None:
    active = data.get("active_episodes", 0)
    capacity = data.get("total_capacity", "?")
    print(
        f"控制面 epoch={data.get('server_epoch', '?')}  "
        f"Worker={data.get('worker_count', 0)}  "
        f"Episode={active}/{capacity}  pending={data.get('pending_results', 0)}"
    )
    workers = data.get("workers", [])
    if not workers:
        print("尚无 Worker 注册。")
        return
    print()
    print(f"{'WORKER':<30} {'STATUS':<10} {'LOAD':>7} {'HEARTBEAT':>10} ENDPOINT")
    for worker in sorted(workers, key=lambda item: item.get("worker_id", "")):
        print(
            f"{worker.get('worker_id', '-'):<30} "
            f"{worker.get('status', '-'):<10} "
            f"{worker.get('load', 0)}/{worker.get('capacity', '?'):>5} "
            f"{fmt_secs(worker.get('last_heartbeat_secs')):>10} "
            f"{worker.get('endpoint', '-')}"
        )


def cmd_status(args: argparse.Namespace) -> None:
    print_status(fetch_status(args))


def cmd_workers(args: argparse.Namespace) -> None:
    data = fetch_status(args)
    workers = data.get("workers", [])
    if not workers:
        print("尚无 Worker 注册。")
        return
    for worker in sorted(workers, key=lambda item: item.get("worker_id", "")):
        print(
            f"[{worker.get('status', 'unknown').upper()}] {worker.get('worker_id', '-')} "
            f"({worker.get('endpoint', '-')}) load={worker.get('load', 0)}/"
            f"{worker.get('capacity', '?')}"
        )
        episodes = worker.get("episodes", [])
        if not episodes:
            print("  无运行中的 Episode")
        for episode in episodes:
            print(
                f"  episode={episode.get('episode_id', '-')} "
                f"batch={episode.get('batch_id', '-')} "
                f"elapsed={fmt_secs(episode.get('elapsed_secs'))}"
            )


def cmd_watch(args: argparse.Namespace) -> None:
    while True:
        print("\033[2J\033[H", end="")
        print(f"UEnv 状态  {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        try:
            cmd_status(args)
        except CliError as exc:
            print(exc, file=sys.stderr)
        time.sleep(args.interval)


def systemd_state(unit: str) -> str:
    if not shutil.which("systemctl"):
        return "未安装 systemd"
    result = subprocess.run(
        ["systemctl", "is-active", unit],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip() or "未安装"


def doctor_line(ok: bool, name: str, detail: str) -> bool:
    print(f"[{'通过' if ok else '失败'}] {name}: {detail}")
    return ok


def hub_health_url(config_dir: Path) -> str:
    """Hub 健康检查地址。独立 Hub 可绑定非回环地址，不能总是查 127.0.0.1。"""
    override = os.environ.get("UENV_HUB_URL")
    if override:
        return f"{override.rstrip('/')}/healthz"
    host, port = "127.0.0.1", 8080
    try:
        in_server = False
        for raw in (config_dir / "hub.toml").read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if line.startswith("["):
                in_server = line == "[server]"
                continue
            if not in_server or "=" not in line:
                continue
            key, value = (part.strip() for part in line.split("=", 1))
            if key == "host":
                host = value.strip('"').strip("'") or host
            elif key == "port":
                port = int(value)
    except Exception:
        pass
    if host in {"", "0.0.0.0", "::"}:
        host = "127.0.0.1"
    return f"http://{host}:{port}/healthz"


def cmd_doctor(args: argparse.Namespace) -> None:
    checks: list[bool] = []
    manifest = args.install_root / "manifest.json"
    checks.append(doctor_line(manifest.is_file(), "安装清单", str(manifest)))

    configured = []
    for name in ("server.yaml", "worker.yaml", "hub.toml"):
        path = args.config_dir / name
        if path.is_file():
            configured.append(name)
    checks.append(
        doctor_line(bool(configured), "配置文件", ", ".join(configured) or f"{args.config_dir} 为空")
    )

    for role, unit in SERVICES.items():
        if (args.config_dir / f"{role}.yaml").exists() or (
            role == "hub" and (args.config_dir / "hub.toml").exists()
        ):
            state = systemd_state(unit)
            checks.append(doctor_line(state == "active", unit, state))

    admin_ok, admin_detail = http_ok(f"{args.admin_url.rstrip('/')}/health")
    if (args.config_dir / "server.yaml").exists():
        checks.append(doctor_line(admin_ok, "控制面健康检查", admin_detail or args.admin_url))

    worker_ok, worker_detail = http_ok(f"{args.worker_url.rstrip('/')}/health")
    if (args.config_dir / "worker.yaml").exists():
        checks.append(doctor_line(worker_ok, "Worker 健康检查", worker_detail or args.worker_url))

    hub_url = hub_health_url(args.config_dir)
    hub_ok, hub_detail = http_ok(hub_url)
    if (args.config_dir / "hub.toml").exists():
        checks.append(doctor_line(hub_ok, "Hub 健康检查", hub_detail or hub_url))

    failed = sum(not result for result in checks)
    print(f"\n{len(checks) - failed}/{len(checks)} 项通过。")
    if failed:
        raise CliError(f"有 {failed} 项需要处理；可运行 `uenv logs <组件>` 查看日志")


def cmd_logs(args: argparse.Namespace) -> None:
    if not shutil.which("journalctl"):
        raise CliError("当前系统没有 journalctl")
    command = ["journalctl", "-u", SERVICES[args.component], "-n", str(args.lines)]
    if args.follow:
        command.append("-f")
    os.execvp(command[0], command)


def find_hub_cli(args: argparse.Namespace) -> Path:
    configured = os.environ.get("UENV_HUB_CLI")
    candidates = [
        Path(configured) if configured else None,
        args.install_root / "bin" / "uenv-hub-cli",
        Path("/usr/local/libexec/uenv/uenv-hub-cli"),
    ]
    for candidate in candidates:
        if candidate and candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise CliError("未找到 Hub CLI；请安装包含 Hub client 的 UEnv 发布包")


def cmd_env(args: argparse.Namespace) -> None:
    if args.hub_args and args.hub_args[0] == "plugin":
        script = args.install_root / "libexec" / "uenv" / "environment" / "plugin.sh"
        if not script.is_file():
            raise CliError(f"当前 release 不包含 process plugin 工具：{script}")
        os.execv(
            "/usr/bin/env",
            ["/usr/bin/env", "bash", str(script), *args.hub_args[1:]],
        )
    binary = find_hub_cli(args)
    os.execv(str(binary), [str(binary), "env", *args.hub_args])


def cmd_hub(args: argparse.Namespace) -> None:
    binary = find_hub_cli(args)
    os.execv(str(binary), [str(binary), "hub", *args.hub_args])


def cmd_version(args: argparse.Namespace) -> None:
    version_file = args.install_root / "VERSION"
    version = version_file.read_text(encoding="utf-8").strip() if version_file.is_file() else "development"
    print(f"uenv {version}")


def parse_local_manifest(path: Path) -> dict[str, object]:
    """Read the small, stable subset shared by bundled plugin manifests.

    The operations CLI intentionally has no PyYAML dependency, so this parser
    only accepts scalar identity fields and the datasets string list. Full
    authoring validation remains the responsibility of `uenv env validate`.
    """
    result: dict[str, object] = {"source": str(path.parent), "datasets": []}
    in_datasets = False
    for raw in path.read_text(encoding="utf-8").splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped == "datasets:":
            in_datasets = True
            continue
        if in_datasets and stripped.startswith("- "):
            datasets = result["datasets"]
            assert isinstance(datasets, list)
            datasets.append(stripped[2:].strip().strip('"\''))
            continue
        in_datasets = False
        for key in ("env_type", "version", "description"):
            prefix = f"{key}:"
            if stripped.startswith(prefix):
                result[key] = stripped[len(prefix) :].strip().strip('"\'')
                break
    return result


def local_plugin_dirs(args: argparse.Namespace) -> list[Path]:
    dirs = [args.install_root / "plugins", Path("/var/lib/uenv/plugins")]
    configured = os.environ.get("UENV_PLUGIN_DIRS", "")
    dirs.extend(Path(item) for item in configured.split(":") if item.strip())
    seen: set[Path] = set()
    unique: list[Path] = []
    for path in dirs:
        if path in seen:
            continue
        seen.add(path)
        unique.append(path)
    return unique


def cmd_environments(args: argparse.Namespace) -> None:
    items: dict[str, dict[str, object]] = {}
    for plugin_dir in local_plugin_dirs(args):
        if not plugin_dir.is_dir():
            continue
        for manifest in sorted(plugin_dir.glob("*/manifest.yaml")):
            try:
                item = parse_local_manifest(manifest)
            except (OSError, UnicodeError) as exc:
                print(f"警告：无法读取 {manifest}: {exc}", file=sys.stderr)
                continue
            env_type = str(item.get("env_type") or "").strip()
            if env_type:
                item["status"] = "legacy" if env_type == "math" else "ready"
                items[env_type] = item

    if (args.config_dir / "swe.env").is_file():
        items.setdefault(
            "swe",
            {
                "env_type": "swe",
                "version": "runtime",
                "description": "repository-level software engineering environment",
                "datasets": ["swe-bench-verified", "swe-bench-pro", "swe-smith"],
                "source": str(args.config_dir / "swe.env"),
                "status": "ready",
            },
        )
    ordered = [items[key] for key in sorted(items)]
    if args.json:
        print(json.dumps(ordered, ensure_ascii=False, indent=2))
        return
    if not ordered:
        print("未发现本地环境。")
        return
    print(f"{'ENV_TYPE':<16} {'STATUS':<10} {'VERSION':<12} DATASETS")
    for item in ordered:
        datasets = ",".join(str(value) for value in item.get("datasets", [])) or "-"
        print(
            f"{str(item.get('env_type', '-')):<16} "
            f"{str(item.get('status', '-')):<10} "
            f"{str(item.get('version', '-')):<12} {datasets}"
        )


def cmd_evaluate(args: argparse.Namespace) -> None:
    script = args.install_root / "libexec" / "uenv" / "evaluation" / "evaluate.sh"
    if not script.is_file():
        raise CliError(f"当前 release 不包含通用评测入口：{script}")
    os.execv("/usr/bin/env", ["/usr/bin/env", "bash", str(script), *args.evaluate_args])


def cmd_train(args: argparse.Namespace) -> None:
    script = args.install_root / "bin" / "uenv-train"
    if not script.is_file():
        script = args.install_root / "scripts" / "uenv-train"
    if not script.is_file():
        raise CliError(f"当前 release 不包含训练入口：{script}")
    os.execv("/usr/bin/env", ["/usr/bin/env", "bash", str(script), *args.train_args])


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="UEnv 安装、运行与环境管理的统一入口")
    parser.add_argument("--admin-url", default=DEFAULT_ADMIN_URL, help="控制面 Admin HTTP 地址")
    parser.add_argument("--worker-url", default=DEFAULT_WORKER_URL, help="Worker 健康检查地址")
    parser.add_argument("--install-root", type=Path, default=DEFAULT_ROOT, help=argparse.SUPPRESS)
    parser.add_argument("--config-dir", type=Path, default=DEFAULT_CONFIG, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="查看控制面、Worker 和 Episode 状态").set_defaults(func=cmd_status)
    sub.add_parser("workers", help="查看 Worker 上运行的 Episode").set_defaults(func=cmd_workers)
    watch = sub.add_parser("watch", help="持续刷新运行状态")
    watch.add_argument("--interval", type=float, default=2.0, help="刷新间隔（秒）")
    watch.set_defaults(func=cmd_watch)
    sub.add_parser("doctor", help="检查配置、服务和健康端点").set_defaults(func=cmd_doctor)

    environments = sub.add_parser("environments", help="列出当前节点已安装的环境与数据集")
    environments.add_argument("--json", action="store_true")
    environments.set_defaults(func=cmd_environments)

    logs = sub.add_parser("logs", help="查看组件日志")
    logs.add_argument("component", choices=sorted(SERVICES))
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("-n", "--lines", type=int, default=100)
    logs.set_defaults(func=cmd_logs)

    env = sub.add_parser("env", help="创建、验证、发布或同步环境")
    env.add_argument("hub_args", nargs=argparse.REMAINDER)
    env.set_defaults(func=cmd_env)
    hub = sub.add_parser("hub", help="登录或查看 Hub 配置")
    hub.add_argument("hub_args", nargs=argparse.REMAINDER)
    hub.set_defaults(func=cmd_hub)
    evaluate = sub.add_parser(
        "evaluate", help="通过 UEnv Server 执行通用评测 JSONL", add_help=False
    )
    evaluate.add_argument("evaluate_args", nargs=argparse.REMAINDER)
    evaluate.set_defaults(func=cmd_evaluate)
    train = sub.add_parser(
        "train", help="运行显式指定任务的 VeRL 训练或底层训练阶段", add_help=False
    )
    train.add_argument("train_args", nargs=argparse.REMAINDER)
    train.set_defaults(func=cmd_train)
    sub.add_parser("version", help="显示已安装版本").set_defaults(func=cmd_version)
    return parser


def main() -> int:
    parser = build_parser()
    args, unknown = parser.parse_known_args()
    if unknown:
        passthrough = {
            "env": "hub_args",
            "hub": "hub_args",
            "evaluate": "evaluate_args",
            "train": "train_args",
        }.get(args.command)
        if passthrough is None:
            parser.error(f"unrecognized arguments: {' '.join(unknown)}")
        getattr(args, passthrough).extend(unknown)
    try:
        args.func(args)
        return 0
    except CliError as exc:
        print(f"错误：{exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())

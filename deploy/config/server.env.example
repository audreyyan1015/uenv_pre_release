UENV_ADDR=0.0.0.0:50051
UENV_CONFIG_PATH=/etc/uenv/server.yaml
UENV_SERVER_CONFIG_STRICT=1
UENV_OBS_ENABLED=1
# Keep data-bearing HTTP interfaces local by default. For multi-node access,
# bind a controlled private address and configure a token plus firewall rules.
UENV_OBS_HTTP_LISTEN=127.0.0.1:50053
UENV_OBS_DATA_DIR=/var/lib/uenv/server/obs
UENV_TRAJECTORY_ENABLED=1
UENV_TRAJECTORY_HTTP_LISTEN=127.0.0.1:8077
UENV_TRAJECTORY_DATA_DIR=/var/lib/uenv/server/trajectory
UENV_LOG_FORMAT=json
UENV_LOG_ANSI=0
RUST_LOG=info,uenv_server=info,uenv_adapter_core=info,tower_http=warn
